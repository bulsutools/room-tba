# Room TBA (BulSU Malolos fork) environment variables
#
# Quick start:
#   cp .env.example .env.local
#   Fill DATABASE_URL (Neon), ADMIN_PASSWORD, ADMIN_SESSION_SECRET
#   bun run setup:bulsu
#   bunx astro dev --port 4331
#
# Files (gitignored except this example):
#   .env          — optional shared base
#   .env.local    — local dev (Astro/Vite loads with .env)

# --- Local / Vercel (Neon free tier or any Postgres) ---
# Prefer the Neon direct host for drizzle-kit push; pooler OK for the app.
DATABASE_URL=

ADMIN_PASSWORD=
# Preferred signing secret for admin_session cookies (falls back to ADMIN_PASSWORD if unset).
ADMIN_SESSION_SECRET=

# Vercel ISR on-demand revalidation (32+ chars). Set in Production + Preview; optional locally.
ISR_BYPASS_TOKEN=

# MapTiler vector tiles (restrict key to localhost + *.vercel.app). Leave User-Agent empty.
PUBLIC_MAPTILER_KEY=

# App environment banner: staging | production
PUBLIC_APP_ENV=staging

# Optional Supabase Auth client (not required for Neon-only fork)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Kubo dorm directory (UPLB-oriented; leave unset for BulSU)
# KUBO_ROOM_TBA_DIRECTORY_URL=

# Cloudflare R2 image uploads (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Notification gateway (Discord bot — optional)
# NOTIFICATION_GATEWAY_URL=
# NOTIFICATION_INGRESS_SECRET=

# Resend — proposal digest (optional)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# CRON_SECRET=

# Cloudflare Turnstile on editor login (optional; skipped when unset)
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# E2E / CI only (separate DB). Not used for local BulSU seed.
# E2E_DATABASE_URL=
