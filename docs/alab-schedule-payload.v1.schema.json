{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://room-tba.uplb.tools/schemas/alab-schedule-payload.v1.json",
  "title": "ALAB schedule payload v1",
  "description": "Versioned schedule export shared by the GradeSim/ALAB bridge (bulsutools/alab-grade-tools) and Room TBA. Schedule fields only; grades and scores must never appear in this payload.",
  "type": "object",
  "required": ["schemaVersion", "classes"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "string",
      "description": "Exporter identifier, e.g. \"alab-grade-tools\". Informational only.",
      "maxLength": 64
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 export timestamp."
    },
    "term": {
      "type": "object",
      "description": "Academic term the schedule belongs to. `id` is the Room TBA terms.id when the exporter knows it; otherwise schoolYear+semester (or label) is used to resolve it.",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "maxLength": 120 },
        "schoolYear": { "type": "string", "maxLength": 16, "examples": ["2026-2027"] },
        "semester": { "type": "string", "maxLength": 12, "examples": ["1", "2", "midyear"] }
      },
      "additionalProperties": true
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/classEntry" }
    }
  },
  "$defs": {
    "classEntry": {
      "type": "object",
      "required": ["courseCode", "section", "type", "meetings"],
      "additionalProperties": true,
      "properties": {
        "courseCode": { "type": "string", "minLength": 1, "maxLength": 16 },
        "courseTitle": { "type": "string", "maxLength": 200 },
        "section": { "type": "string", "minLength": 1, "maxLength": 16 },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "description": "Component type, e.g. LEC, LAB, SEM, RCT.",
          "examples": ["LEC", "LAB", "SEM"]
        },
        "professor": { "type": "string", "maxLength": 120 },
        "isOnline": { "type": "boolean" },
        "meetings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/meeting" }
        }
      }
    },
    "meeting": {
      "type": "object",
      "required": ["weekday", "startTime", "endTime"],
      "additionalProperties": true,
      "properties": {
        "weekday": {
          "type": "string",
          "description": "Single meeting day. Accepts M/T/W/Th/F/S/Su, TH, or full English day names, any case.",
          "examples": ["M", "Th", "Friday"]
        },
        "startTime": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}$", "examples": ["07:00", "13:30"] },
        "endTime": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}$", "examples": ["08:30", "15:00"] },
        "mode": {
          "type": "string",
          "maxLength": 12,
          "description": "ALAB meeting mode (LEC/LAB/SEM). Informational.",
          "examples": ["LEC", "LAB", "SEM"]
        },
        "isOnline": { "type": "boolean" },
        "room": {
          "type": ["object", "null"],
          "properties": {
            "code": { "type": "string", "maxLength": 32 },
            "name": { "type": "string", "maxLength": 120 }
          },
          "required": ["code"],
          "additionalProperties": true
        }
      }
    }
  }
}
