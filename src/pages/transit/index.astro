---
import AppRoot from "@ui/AppRoot.svelte";
import Layout from "@layouts/Layout.astro";
import { JEEPNEY_ROUTES } from "@constants/jeepney-routes";
import { breadcrumbSchema, jsonLd, ogCardPath, webpageSchema } from "@lib/site";
import { campusSite, campusTransit } from "../../campus.config";

const transitLabel = campusTransit.label;
const transitLower = transitLabel.toLowerCase();
const title = `${transitLabel} at ${campusSite.placeLabel} | Room TBA`;
const description = `Browse ${campusSite.placeLabel} ${transitLower}, stops, fares, and map paths.`;
const structuredData = jsonLd(
  webpageSchema({ title, description, path: "/transit/" }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: transitLabel, path: "/transit/" },
  ]),
);
---

<Layout
  {title}
  description={description}
  canonicalPath="/transit/"
  imagePath={ogCardPath({
    title: transitLabel,
    subtitle:
      JEEPNEY_ROUTES.map((route) => route.name).join(" · ") ||
      `${campusSite.placeLabel} campus`,
    kicker: `Transit at ${campusSite.placeLabel}`,
  })}
  {structuredData}
>
  <main class="transit-page">
    <article class="sr-only">
      <h1>{transitLabel.toLowerCase()}</h1>
      <p>{description}</p>
      <ul>
        {JEEPNEY_ROUTES.map((route) => <li>{route.name}: {route.description}</li>)}
      </ul>
    </article>
    <AppRoot client:only="svelte" suppressLandingModal={true} />
  </main>
</Layout>

<style>
  .transit-page { height: 100dvh; overflow: hidden; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
